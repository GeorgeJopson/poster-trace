{
  "name": "poster-trace",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "netlify database migrations apply",
    "seed": "tsx scripts/seed.ts",
    "db:reset": "netlify database reset && netlify database migrations apply",
    "prettier": "prettier --write .",
    "email:dev": "email dev --dir infrastructure/email/templates",
    "test:e2e": "npm run db:reset && playwright test",
    "test": "vitest run --project unit",
    "test:db": "bash scripts/test-db.sh",
    "test:all": "npm test && npm run test:db && npm run test:e2e",
    "prepare": "husky"
  },
  "dependencies": {
    "@netlify/blobs": "^11.1.4",
    "@netlify/database": "^2.0.1",
    "@radix-ui/react-dialog": "^1.2.0",
    "@radix-ui/react-visually-hidden": "^1.2.12",
    "@react-email/render": "2.1.0",
    "@react-spring/web": "^10.1.2",
    "better-auth": "^1.7.7",
    "drizzle-orm": "1.0.0-rc.4",
    "next": "16.4.3",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.5.438",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-email": "6.11.1",
    "recharts": "3.10.1",
    "resend": "^6.33.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@csstools/postcss-global-data": "^4.0.0",
    "@playwright/test": "^1.64.1",
    "@react-email/ui": "6.11.1",
    "@types/node": "^26.5.0",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "babel-plugin-react-compiler": "1.0.0",
    "dotenv": "^17.4.2",
    "drizzle-kit": "1.0.0-rc.4",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "husky": "^9.1.7",
    "jsqr": "1.4.0",
    "lint-staged": "^17.6.0",
    "new-component": "^6.0.0",
    "postcss-custom-media": "^12.0.1",
    "prettier": "^3.9.6",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "unrs-resolver@1.12.2": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true
  }
}
